# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Site URL (used for auth redirects, QR codes, etc.)
VITE_SITE_URL=https://your-hackathon.example.com

# URL path where the app is mounted. Must start and end with a slash.
VITE_BASE_PATH=/

# 可选：覆盖默认的 Supabase Edge Function 排行榜代理地址
# VITE_ARCBENCH_LEADERBOARD_PROXY=https://your-project.supabase.co/functions/v1/arcbench-leaderboard
